CHIK_CLIM/01_Data/ibge_muni_polygons.rds

# Raster / model outputs (large)
CHIK_CLIM/01_Data/*.tif
CHIK_CLIM/01_Data/*.zip

# Month panel CSV is optional; RDS is smaller — keep CSV ignored if large
# CHIK_CLIM/01_Data/chik_brazil_muni_month_*.csv

