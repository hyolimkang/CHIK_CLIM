CHIK_CLIM/01_Data/era5_cache/
CHIK_CLIM/01_Data/chik_muni_week_climate_*.csv
CHIK_CLIM/01_Data/chik_muni_week_climate_*.rds
CHIK_CLIM/01_Data/chik_dlnm_panel_muni_week_*.csv
CHIK_CLIM/01_Data/chik_dlnm_panel_muni_week_*.rds

# Municipality polygons (196MB, exceeds GitHub's 100MB limit) — regenerate
